# Copy this file to .env and fill in your key.

# Required: your Anthropic API key (get one at https://console.anthropic.com/).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: which model refines notes. Defaults to claude-sonnet-4-6 (fast + cheap,
# right for a per-note formatting task). Set to claude-opus-5 for higher quality.
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: port to serve on. Defaults to 3000.
# PORT=3000
