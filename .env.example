# Copy this file to .env and fill in your key.

# Required: your Anthropic API key (get one at https://console.anthropic.com/).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: cost preset - economy | balanced (default) | quality.
# Capture runs constantly and drives cost; the reasoning jobs run on demand.
#   economy   Haiku everywhere            (~$0.37 per 100 captures)
#   balanced  Haiku capture, Sonnet think (~$0.37 per 100 captures + better answers)
#   quality   Sonnet capture, Opus think  (~$1.09 per 100 captures)
# LUCID_COST_MODE=balanced

# Optional: force one Claude model for all three jobs (overrides the preset).
# ANTHROPIC_MODEL=claude-sonnet-4-6
#
# Optional: override the model per job. Handy for putting a cheap, fast model on
# high-volume capture while keeping a stronger one for the reasoning work:
#   ANTHROPIC_MODEL_REFINE=claude-haiku-4-5     # structuring each captured thought
#   ANTHROPIC_MODEL_DEVELOP=claude-sonnet-4-6   # the "go deeper" conversation
#   ANTHROPIC_MODEL_STANDUP=claude-sonnet-4-6   # the "where it stands" read

# Required for voice capture: your Google Gemini API key (free tier at
# https://aistudio.google.com/apikey). Used to transcribe recorded audio.
# Without it, the mic button still records but transcription will fail; typing works.
GEMINI_API_KEY=

# Optional: which Gemini model transcribes audio. Defaults to gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash

# Optional: port to serve on. Defaults to 3000.
# PORT=3000
